# ─────────────────────────────────────────────────────────────────────────────
# SLA Monitoring Dashboard — environment variable reference
#
# Copy the relevant block into the file named below and fill in real values.
# Never commit the filled-in files; .gitignore already excludes them.
# ─────────────────────────────────────────────────────────────────────────────

# ── apps/worker/.dev.vars ────────────────────────────────────────────────────
# Cloudflare Worker secrets. Used by `wrangler dev` locally; in production these
# are set with `wrangler secret put <NAME>` and never live in the repo.
#
# The service-role key bypasses Row Level Security. It must ONLY ever exist in
# the Worker. It must never be sent to, or referenced by, the browser bundle.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated list of browser origins allowed to call the Worker (CORS).
ALLOWED_ORIGINS=http://localhost:3000

# Upload guard rails (optional — these are the defaults if unset).
MAX_UPLOAD_BYTES=15728640
MAX_CHUNK_BYTES=1048576
MAX_ROWS_PER_UPLOAD=250000


# ── apps/web/.env.local ──────────────────────────────────────────────────────
# Next.js frontend. Only NEXT_PUBLIC_* values reach the browser, so this file
# must never contain a database URL or any Supabase key.
#
# Local development points at `wrangler dev`; production points at the deployed
# Worker (https://<name>.<subdomain>.workers.dev).

NEXT_PUBLIC_API_BASE_URL=http://localhost:8787

# SLA target used for the comparison display, as a percentage.
# This is the contractual target to measure against — never the actual value,
# which is always computed from persisted data.
NEXT_PUBLIC_SLA_TARGET=99.9
